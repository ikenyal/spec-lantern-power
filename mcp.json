      "args": [
        "-y",
        "github:ikenyal/spec-lantern-power#v0.1.0"
      ],
      "env": {
        "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      },
      "disabled": false,
